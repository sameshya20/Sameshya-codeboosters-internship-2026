      "source": [
        "def ask_llm(user_message, system_message=\"You are a helpful assistant\",temperature=0.7,max_token=500):\n",
        "  \"\"\"\n",
        "  user_message : The message from the user to the assistant.\n",
        "  system_message : The system-level instructions for the assistant.\n",
        "  temperature : The sampling temperature for the model.\n",
        "  max_token : The maximum number of tokens to generate.\n",
        "  \"\"\"\n",
        "\n",
        "\n",
        "  response=client.chat.completions.create(\n",
        "      model=MODEL,\n",
        "      messages=[\n",
        "          {\"role\":\"system\",\"content\":system_message},\n",
        "          {\"role\":\"user\",\"content\":user_message}\n",
        "      ],\n",
        "      temperature=temperature,\n",
        "      max_tokens=max_token\n",
        "  )\n",
        "  return response.choices[0].message.content\n",
        "\n",
        "test_response=ask_llm(\"What is the capital of India?\")\n",
        "test_response2=ask_llm(\"What is the capital of TamilNadu?\")\n",
        "print(test_response)\n",
        "print(test_response2)"
      ],
